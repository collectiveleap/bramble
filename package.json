{
  "name": "bramble",
  "version": "0.1.0",
  "description": "Generated by Phoenix VCS — 8 services",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:dxos": "tsc && node dist/generated/dxos/server.js",
    "start:editing": "tsc && node dist/generated/editing/server.js",
    "start:frames-run": "tsc && node dist/generated/frames-run/server.js",
    "start:graph": "tsc && node dist/generated/graph/server.js",
    "start:interaction": "tsc && node dist/generated/interaction/server.js",
    "start:nodes": "tsc && node dist/generated/nodes/server.js",
    "start:server": "tsc && node dist/generated/server/server.js",
    "start:web": "tsc && node dist/generated/web/server.js",
    "start": "tsc && node dist/generated/dxos/server.js"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
